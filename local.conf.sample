MACHINE ??= 'imx8mm-som-gp'
DISTRO ?= 'fsl-imx-xwayland'
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
PACKAGECONFIG:append:pn-qemu-system-native = " sdl"
CONF_VERSION = "2"

ACCEPT_FSL_EULA = "1"

# Switch to Debian packaging and include package-management in the image
PACKAGE_CLASSES = "package_deb"
EXTRA_IMAGE_FEATURES += "package-management"

INHERIT += "image-buildinfo"
INHERIT += "devshell"
INHERIT += "rm_work"

# Configure sstate and downloads cache, if they exist.
#DL_DIR ?= "/home/CACHE/5.15.71/downloads/"
#SSTATE_DIR ?= "/home/CACHE/5.15.71/sstate-cache/"

# Mask this patch
BBMASK += "meta-freescale-3rdparty/recipes-bsp/u-boot/u-boot-imx_%.bbappend"

# Add useful "gpio" tool to the image
IMAGE_INSTALL:append = "imx-uuc libgpiod libgpiod-tools"

# doesn't build on Ubuntu20, used gn_git.bb instead.
BBMASK += "meta-qt6/recipes-qt/qt6/gn-native_git.bb"
