From 81008cc657a2459c3a5acc91e77e0e4f8c1c682b Mon Sep 17 00:00:00 2001
From: Alexander Sanochkin <sasha@emcraft.com>
Date: Mon, 10 Mar 2025 15:53:35 +0100
Subject: [PATCH] RM-7316: Add M4 support for NAVQ board in the  NXP BSP
 6.6.52_2.2.0

---
 arch/arm64/boot/dts/freescale/imx8mm-navq.dts | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mm-navq.dts b/arch/arm64/boot/dts/freescale/imx8mm-navq.dts
index b3fd5ec34659..1a62bb5f82e3 100644
--- a/arch/arm64/boot/dts/freescale/imx8mm-navq.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mm-navq.dts
@@ -10,6 +10,8 @@
 #include "imx8mm.dtsi"
 
 / {
+	compatible = "emcraft,imx8mm-som", "fsl,imx8mm";
+
 	chosen {
 		stdout-path = &uart2;
 	};
@@ -19,6 +21,51 @@ memory@40000000 {
 		reg = <0x0 0x40000000 0 0x80000000>;
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		m4_reserved: m4@80000000 {
+			no-map;
+			reg = <0 0x80000000 0 0x1000000>;
+		};
+
+		vdev0vring0: vdev0vring0@b8000000 {
+			reg = <0 0xb8000000 0 0x8000>;
+			no-map;
+		};
+
+		vdev0vring1: vdev0vring1@b8008000 {
+			reg = <0 0xb8008000 0 0x8000>;
+			no-map;
+		};
+
+		rsc_table: rsc-table@b80ff000 {
+			reg = <0 0xb80ff000 0 0x1000>;
+			no-map;
+		};
+
+		vdevbuffer: vdevbuffer@b8400000 {
+			compatible = "shared-dma-pool";
+			reg = <0 0xb8400000 0 0x100000>;
+			no-map;
+		};
+	};
+
+	imx8mm-cm4 {
+		compatible = "fsl,imx8mm-cm4";
+		rsc-da = <0xb8000000>;
+		clocks = <&clk IMX8MM_CLK_M4_DIV>;
+		mbox-names = "tx", "rx", "rxdb";
+		mboxes = <&mu 0 1
+			  &mu 1 1
+			  &mu 3 1>;
+                memory-region = <&vdevbuffer>, <&vdev0vring0>, <&vdev0vring1>, <&rsc_table>;
+                syscon = <&src>;
+                fsl,startup-delay-ms = <500>;
+        };
+
 	leds {
 		compatible = "gpio-leds";
 		pinctrl-names = "default";
